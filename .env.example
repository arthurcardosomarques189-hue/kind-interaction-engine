# ClipForge AI — local development
# Copy to .env.local and fill these values from your Supabase project.
# Never commit .env.local or expose server secrets in VITE_* variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to start video transcription jobs from the upload flow
ASSEMBLYAI_API_KEY=
